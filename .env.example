# Copy to .env.local and fill in real values. Never commit real credentials.

# Neon PostgreSQL connection string (server-only)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API key (server-only)
GEMINI_API_KEY=your-gemini-api-key

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# App configuration (safe to expose to the browser)
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_INTERVIEW_INFO="Enable Video Web Cam and Microphone to start your AI generated mock interview. NOTE: We never record your video."
NEXT_PUBLIC_INFORMATION="Enable Video Web Cam and Microphone to start your AI generated mock interview. NOTE: We never record your video."
